# Server port
PORT=3000

# "local" → STORAGE_PATH is a local or UNC path (recommended for Windows)
# "smb"   → same, but server also runs `net use` on startup to authenticate
STORAGE_TYPE=local

# Path to the recordings root.
# Local example:  ./video_example
# UNC example:    \\192.168.1.100\cctv
STORAGE_PATH=./video_example

# SMB credentials (only used when STORAGE_TYPE=smb)
# Never commit real credentials — keep them in .env only
SMB_HOST=192.168.1.x
SMB_SHARE=cctv
SMB_USERNAME=user
SMB_PASSWORD=secret

# Retention window in days, used only by the maintenance script
# (server/maintenance/run.js — not the viewer app). Recording date-folders
# older than this many days are deleted and index.db is regenerated to
# match what's left. Unset/0 = maintenance script refuses to run.
RETENTION_DAYS=30

# Comma-separated camera IDs (folder names under STORAGE_PATH) the
# maintenance script is allowed to prune/rebuild. Cameras NOT listed here
# are left completely untouched — use this for cameras still actively
# managed by the camera itself (own retention, own index.db), and only
# list cameras with no live local writer (e.g. an S3-synced archive folder).
# Empty/unset = the maintenance script manages nothing.
MAINTENANCE_CAMERAS=axis-b8a44f6c2746
